<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Force HTTPS and non-www (Single redirect to avoid chains)
    RewriteCond %{HTTP_HOST} ^www\.pathfinderdefenceacademy\.com [NC,OR]
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://pathfinderdefenceacademy.com/$1 [L,R=301]

    # 2. Redirect legacy URLs that were renamed
    RewriteRule ^courses/ssb\.html$ /courses/ssb-interview-coaching-lucknow [R=301,L]
    RewriteRule ^courses/ssb/?$ /courses/ssb-interview-coaching-lucknow [R=301,L]
    RewriteRule ^courses/sainik-school\.html$ /courses/sainik-school-coaching-lucknow [R=301,L]
    RewriteRule ^courses/sainik-school/?$ /courses/sainik-school-coaching-lucknow [R=301,L]

    # 3. Redirect remaining `.html` requests directly to clean URL
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /+(.*)\.html[\?\ ]
    RewriteRule ^(.*)\.html$ /$1 [R=301,L]

    # 3. Redirect trailing slash to non-trailing slash
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)/$ /$1 [L,R=301]

    # 4. Serve Next.js static export `.html` files silently for clean URLs
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^(.*)$ /$1.html [L]

</IfModule>

# Handle 404 cleanly by serving Next.js default 404 page
ErrorDocument 404 /404.html

# Cache control for static assets (optional but recommended for speed)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-javascript "access plus 1 month"
</IfModule>
