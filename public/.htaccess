<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect non-www to www (optional but good for SEO canonicalization)
    # RewriteCond %{HTTP_HOST} ^pathfinderdefenceacademy\.com [NC]
    # RewriteRule ^(.*)$ https://www.pathfinderdefenceacademy.com/$1 [L,R=301]

    # 1. Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2. Redirect non-trailing-slash to trailing-slash
    # Exclude actual files (like images, .css, .js)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} !(.*)/$
    RewriteRule ^(.*)$ /$1/ [L,R=301]

    # 3. Serve Next.js static export structure
    # If the requested URI with /index.html appended exists, serve it
    RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}index\.html -f
    RewriteRule ^(.*)$ $1index.html [L]
    
    # 4. Handle `.html` requests cleanly
    # If someone requests /page.html and it doesn't exist, don't crash (500), force a 404.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} \.html$
    RewriteRule ^ - [R=404,L]

</IfModule>

# Handle 404 cleanly by serving Next.js default 404 page
ErrorDocument 404 /404.html

# Cache control for static assets (optional but recommended for speed)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-javascript "access plus 1 month"
</IfModule>
